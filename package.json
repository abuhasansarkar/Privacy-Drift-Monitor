{
  "name": "drift-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "pnpm --filter @pdm/database generate",
    "db:migrate": "pnpm --filter @pdm/database migrate",
    "db:deploy": "pnpm --filter @pdm/database migrate:deploy",
    "db:reset": "pnpm --filter @pdm/database migrate:reset",
    "db:seed": "pnpm --filter @pdm/database seed",
    "db:studio": "pnpm --filter @pdm/database studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.3",
    "@pdm/database": "workspace:*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
