# ─────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in.
# PHASE 0 needs only: App, Database, Redis, S3, Clerk.
# Everything else can stay empty until its phase (see PLAN.md Part XII).
# NEVER put a secret behind a NEXT_PUBLIC_ prefix.
# ─────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Privacy Drift Monitor"
LOG_LEVEL=debug

# Must be identical across all web instances and stable across deploys,
# or Server Action closures break. Generate: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Database (docker-compose) ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drift_monitor?schema=public
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/drift_monitor?schema=public
DATABASE_POOL_SIZE=10

# ── Redis (docker-compose) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ── Clerk ── PHASE 0: required. https://dashboard.clerk.com ──────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The name verifyWebhook() reads by default — from the Clerk dashboard's
# webhook endpoint config (whsec_…). Route: POST /api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app/onboarding

# ── Object storage (MinIO locally) ───────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=drift-monitor
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# ── Email ── PHASE 4. Locally, Mailpit catches everything. ───────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Privacy Drift Monitor <alerts@example.com>"
EMAIL_REPLY_TO=support@example.com
SMTP_HOST=localhost
SMTP_PORT=1025

# ── Stripe ── PHASE 6 ────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# ⚠️ WITHOUT THIS THE WEBHOOK REJECTS EVERY REQUEST WITH 401, which is correct
# and deliberate — an endpoint that accepted unverified billing events because a
# variable was missing is the worst possible default. Get it from the Stripe
# dashboard's webhook endpoint config (whsec_…), or from `stripe listen` locally.
#
# Route: POST /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Optional. Without it Stripe uses the account's default portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=

# Provision products and the 24 prices (§9.1) from the §9.3 table:
#   npm run stripe:provision -- --dry-run
#   npm run stripe:provision
# Idempotent via price `lookup_key`; refuses a live key without --live.

# ── AI ── PHASE 5. Provider-independent by design. ───────────────────
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
# ⚠️ MATCHED EXACTLY BY THE PROVIDER. Verified against the live API: the wrong
# case (`GPT-4o-mini`) AND a trailing space both return
# `400 model_not_found`, which is a PERMANENT status we never retry — so a typo
# here presents as "AI is broken", not as "that id is wrong". Lower-case, no
# trailing whitespace. Run `npx tsx --env-file=.env worker/src/ai.smoke.ts`
# after changing either.
#
# ⚠️ UPDATE `DEFAULT_PRICING` IN packages/ai/src/budget.ts WHEN THESE CHANGE.
# It is keyed by TIER, not by model id, so a swap silently prices every call
# against the old model's rate.
AI_MODEL_STANDARD=gpt-4o-mini
AI_MODEL_ADVANCED=gpt-5-nano

# Reasoning effort, for models that spend reasoning tokens (gpt-5*, o-series).
# Sent ONLY to those models — passing it to gpt-4o-mini is a permanent 400.
#
# ⚠️ LEAVE THIS AT `minimal`. Reasoning tokens come out of the SAME
# `max_output_tokens` allowance as the answer, and are billed at the output
# rate. Measured: gpt-5-nano at our 400-token cap with the DEFAULT effort spent
# all 384 output tokens reasoning and returned nothing at all; with `minimal` it
# answers completely in ~222.
AI_REASONING_EFFORT=minimal
AI_MAX_INPUT_TOKENS=1500
AI_TIMEOUT_MS=60000
# The platform-wide backstop against a runaway loop (§8.9). A malformed value
# falls back to this default rather than to 0 — a typo must not disable the cap.
AI_DAILY_BUDGET_USD=50
# The global off switch. `false` stops every AI call platform-wide with no
# deploy. An unset AI_API_KEY has the same effect: the layer fails CLOSED, and
# every AI surface renders its "unavailable" state instead of erroring (P3).
AI_ENABLED=true
# §8.9: a stored response is reused for this long, at zero provider cost.
AI_CACHE_TTL_DAYS=7
# §7.2 fixes the `ai` queue at 5. The limit is the PROVIDER's rate limit, not
# ours — going wider turns a burst of auto-explains into a wall of 429s.
AI_CONCURRENCY=5

# ── Scanner ── PHASE 2 ───────────────────────────────────────────────
SCAN_TIMEOUT_MS=600000
SCAN_NAV_TIMEOUT_MS=30000
SCAN_SETTLE_MAX_MS=15000
SCAN_OBSERVE_MS=10000
SCAN_CONSENT_TIMEOUT_MS=15000
SCAN_PHASE_TIMEOUT_MS=90000
SCAN_PAGE_TIMEOUT_MS=120000
SCAN_MAX_PAGES=10
SCAN_MAX_REDIRECTS=3
SCAN_MAX_RESPONSE_BYTES=52428800
SCAN_CONCURRENCY=2
SCAN_BROWSER_POOL_SIZE=2
SCAN_BROWSER_MAX_USES=50
SCAN_BROWSER_MAX_AGE_MS=1800000
SCAN_CONSENT_MIN_CONFIDENCE=0.5
SCAN_BLOCK_MEDIA=true
SCAN_RESPECT_ROBOTS=true
SCAN_USER_AGENT_SUFFIX="PrivacyDriftMonitor/1.0 (+http://localhost:3000/bot)"
SCANNER_VERSION=1.0.0

# Where the contact form delivers. UNSET MEANS THE FORM RETURNS AN ERROR rather
# than silently discarding a message — a sender who believes they were heard and
# was not is the worst failure this page can have.
SUPPORT_EMAIL=

# ── Abuse control ── PHASE 6 ─────────────────────────────────────────
# The widget needs the site key IN THE BROWSER, so it is duplicated with the
# NEXT_PUBLIC_ prefix. Only the SECRET is a credential; the site key is public
# by construction and appears in the page source of every site using Turnstile.
TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FREE_SCAN_RATE_PER_IP_HOUR=3
FREE_SCAN_RATE_PER_IP_DAY=10
FREE_SCAN_TIMEOUT_MS=45000
FREE_SCAN_RETENTION_DAYS=7
# ⚠️ THE ONE CONTROL THAT MAKES "cannot starve paying customers" TRUE. The free
# worker shares the browser pool with paid scans; keep this a small fraction of
# SCAN_CONCURRENCY or a burst of anonymous submissions will hold every slot.
FREE_SCAN_CONCURRENCY=1
# §3.2: beyond this many WAITING jobs, new submissions get "high demand".
FREE_SCAN_QUEUE_CEILING=200
# Salts the stored IP hash. Set it, or the hash of a v4 address is enumerable.
FREE_SCAN_IP_SALT=
# §5.8: pause between retention delete batches, so it never blocks writes.
RETENTION_PACE_MS=250

# ── Observability ── PHASE 7 ─────────────────────────────────────────
# ⚠️ UNSET MEANS SENTRY IS INERT, NOT BROKEN. `sentryOptions()` returns null and
# nothing initialises — a half-configured error reporter looks like coverage.
SENTRY_DSN=
# The browser needs its own copy. Same DSN; a Sentry DSN is public by design.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Ops ──────────────────────────────────────────────────────────────
MAINTENANCE_MODE=false
# Roles this worker process consumes. Drop `scheduler` on replicas that must
# not sweep (§7.5); drop `ai` to stop this replica draining the AI queue.
WORKER_ROLES=scan,scheduler,notification,email,report,digest,ai,free-scan
