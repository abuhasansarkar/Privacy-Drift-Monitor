# npm configuration.
#
# The previous contents were pnpm-only directives (auto-install-peers,
# public-hoist-pattern) which npm silently ignores. Removed to avoid implying
# behaviour that is not in effect.
#
# npm hoists workspace dependencies to the root node_modules by default, so the
# generated Prisma client is resolvable from every package without extra config.

# Lockfile must stay authoritative; `npm ci` fails loudly if it drifts.
save-exact=false
engine-strict=true
