# syntax=docker/dockerfile:1
#
# THE WEB IMAGE — PLAN.md Part X §10.9, Phase 7 task 7.8.
#
# ⚠️ NO CHROMIUM HERE. §10.9 splits web and worker into separate images for one
# reason: the browser is 1.2 GB of the worker image, and a web tier that carries
# it pays that cost on every deploy, every autoscale event and every rollback —
# for a binary it never executes.
#
# ⚠️ THE PATH IS `.` NOT `apps/web`. §12.1's tree still prints the superseded
# `apps/` layout; §10.9 supersedes it and AGENTS.md says so. There is one app at
# the repository root.

# ── deps ─────────────────────────────────────────────────────────────────────
FROM node:22-slim AS deps
WORKDIR /app

# ⚠️ THE WORKSPACE MANIFESTS ARE COPIED BEFORE THE SOURCE so that a change to a
# source file does not invalidate the install layer. npm workspaces needs every
# member's package.json present for `npm ci` to resolve the tree at all.
COPY package.json package-lock.json ./
COPY packages/ai/package.json ./packages/ai/
COPY packages/analysis/package.json ./packages/analysis/
COPY packages/billing/package.json ./packages/billing/
COPY packages/config/package.json ./packages/config/
COPY packages/database/package.json ./packages/database/
COPY packages/email/package.json ./packages/email/
COPY packages/notifications/package.json ./packages/notifications/
COPY packages/reports/package.json ./packages/reports/
COPY packages/scanner/package.json ./packages/scanner/
COPY packages/schemas/package.json ./packages/schemas/
COPY packages/shared/package.json ./packages/shared/
COPY packages/storage/package.json ./packages/storage/
COPY worker/package.json ./worker/

# ⚠️ `npm ci`, WHICH FAILS IF THE LOCKFILE HAS DRIFTED. That is the point: a
# deploy must build the dependency tree that was reviewed, not resolve a new one.
RUN npm ci --ignore-scripts

# ── builder ──────────────────────────────────────────────────────────────────
FROM node:22-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Prisma's generated client is a build artefact, not a source file, and
# `--ignore-scripts` above deliberately skipped its postinstall.
RUN npx prisma generate --schema packages/database/prisma/schema.prisma

ENV NEXT_TELEMETRY_DISABLED=1
# ⚠️ Turbopack is the default builder in Next 16 for `build` as well as `dev`.
RUN npm run build

# ── runner ───────────────────────────────────────────────────────────────────
FROM node:22-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# ⚠️ NON-ROOT (§10.1's container-compromise row). `node:22-slim` ships a `node`
# user; creating one is not necessary and reusing it keeps the uid stable.
RUN mkdir -p /app && chown -R node:node /app
USER node

# Standalone traces exactly the files the server needs. `static` and `public`
# are NOT included in that trace and must be copied separately — a missing
# `.next/static` is a site that renders unstyled and nobody notices in CI.
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

EXPOSE 3000

# ⚠️ THE READINESS PROBE IS THE HEALTHCHECK, and it reports each dependency
# separately (§10.11): Postgres down is fatal, Redis and object storage are not.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health/ready').then(r=>process.exit(r.status===200?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
